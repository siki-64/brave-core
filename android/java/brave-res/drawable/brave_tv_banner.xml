<!-- Brave TV: 16:9 banner shown on the Android TV / Google TV home screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF2A1F5C"
                android:endColor="#FFFB542B" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="104dp"
        android:height="104dp"
        android:drawable="@mipmap/app_icon" />
</layer-list>
